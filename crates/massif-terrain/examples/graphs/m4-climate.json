{ "terrain": { "size": 8192, "seed": 41 },
  "nodes": {
    "coast": { "type": "coast.coastline", "params": { "land": 0.55, "scale": 6000, "height": 70 } },
    "inner": { "type": "adjust.levels", "inputs": { "in": "coast.land" }, "params": { "in_low": 0.5, "in_high": 1, "out_low": 0, "out_high": 1 } },
    "keep": { "type": "adjust.blur", "inputs": { "in": "inner" }, "params": { "radius": 600 } },
    "range": { "type": "mountain.range", "params": { "spine": [{"x":0.2,"z":0.25},{"x":0.45,"z":0.45},{"x":0.55,"z":0.65},{"x":0.7,"z":0.85}], "height": 200, "width": 2200, "base": 0 } },
    "land": { "type": "combine.blend", "inputs": { "a": "coast", "b": "range", "mask": "keep" }, "params": { "mode": "add" } },
    "temp": { "type": "climate.temperature", "inputs": { "height": "land" }, "params": { "toward": 90, "warm": 32, "cold": -6 } },
    "rain": { "type": "climate.rainfall", "inputs": { "height": "land" }, "params": { "direction": 0, "orographic": 2 } },
    "hum": { "type": "climate.humidity", "inputs": { "height": "land", "rainfall": "rain" }, "params": { "inland": 1200 } },
    "biomes": { "type": "climate.biomes", "inputs": { "temperature": "temp", "humidity": "hum", "height": "land" } },
    "out": { "type": "output.map", "inputs": { "height": "land", "albedo": "biomes.color", "biome": "biomes", "temperature": "temp", "humidity": "hum" } }
  }
}
