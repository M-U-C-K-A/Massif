{
  "terrain": {
    "size": 8192,
    "seed": 18
  },
  "nodes": {
    "coast": {
      "type": "coast.coastline",
      "params": {
        "land": 0.6,
        "scale": 7000,
        "height": 90
      }
    },
    "alps": {
      "type": "mountain.alpine",
      "inputs": {
